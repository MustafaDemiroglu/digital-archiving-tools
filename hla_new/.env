DATABASE_HOST="vhrz2437.hrz.uni-marburg.de"
DATABASE_PORT="5432"
DATABASE_NAME="hladb"
DATABASE_USERNAME="hladb_worker"
DATABASE_PASSWORD="eechuuzethi3ahLi"
DATABASE_TABLE_NAME="checksums"
DATABASE_TEMP_TABLE_NAME="checksums_temp_kitodo"
DATABASE_TABLE_ITEM_IDENTIFIER="full_path"
DATABASE_TABLE_DELIVERY_IDENTIFIER="delivery"

AWK_SCRIPT_PATH="/usr/local/bin/hla_new/validation.awk"
AWK_exclude_regex=""
AWK_filetype_regex_strict="(jpe?g|tiff?|mp4|mkv|wav|mp3)"
AWK_filetype_regex_less_strict="(jpe?g|tiff?|gif|mp4|mkv|wav|mp3|xml)"
AWK_filetype_regex_lax="[abcdefghijklmnopqrstuvwxyz0-9]+"

CHOWN_GROUP="hladigi"
CHMOD_DEFAULT="0660"
# Definieren der Standard Berechtigung (umask) (in dezimal) [https://www.geeksforgeeks.org/python-os-umask-method/]
UMASK_DEFAULT="7"
# define list of specific protection_until value
# 4444 (Kennzeichnung fehlend oder vermisst), 4455 (falsche Signatur, aber im Moment nicht korrigierbar),
# 4466 (Aus Lagerungsgründen nicht nutzbar), 5555 (aus konservatorischen Gründen nicht nutzbar),
# 5566 (provisorische Nutzungssperre aus konservatorischen Gründen),
# 5577 (Sperrung von "Zimelien", Erhaltung finanzieller Wert)
# https://unimarburg.plan.io/attachments/75265
EXCLUDE_PROTECTION_UNTIL_YEARS="4444 4455 4466 5555 5566 5577"

BASE_PATH_CEPH="/media/cepheus"
BASE_PATH_HDD_INGEST_CEPH="/media/cepheus/ingest/hdd_upload"
BASE_PATH_MANIFEST="/media/cepheus/z_others/original_manifest_files"
MANIFEST_ALL="/media/cepheus/manifest/all/all_for_checking.md5"

KITODO_BASE_PATH="/usr/local/kitodo"
KITODO_METADATA_PATH="/usr/local/kitodo/metadata"
KITODO_LOG_PATH="/usr/local/kitodo/logs"
KITODO_IMG_MAX_NAME="max"
KITODO_IMG_THUMB_NAME="thumbs"
KITODO_IMG_TIFF_NAME="tiff"
KITODO_STOCK_NAME="Stock"

NETAPP_PATH="/media/archive/public"
ADDITIONAL_OUTPUT_FOLDER_NETAPP="www"

